# Database Connection URL (Supabase, Vercel Postgres, Neon, Cloud SQL, Railway)
# Direct URI Format: postgres://postgres:[YOUR-PASSWORD]@db.mhxjydlzuvvgbqeepamd.supabase.co:5432/postgres
# Transaction Pooler Format: postgres://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=
SUPABASE_DATABASE_URL=
POSTGRES_URL=

# Individual Connection Parameters (Alternative to DATABASE_URL)
PGHOST=db.mhxjydlzuvvgbqeepamd.supabase.co
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=

# Supabase API Credentials
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
SUPABASE_ANON_KEY=

# Client Framework Conventions (Next.js & Vite)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Resend API Configuration (Recommended HTTPS Email API)
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# SMTP Email Relay Configuration (Alternative / Fallback)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=audit.operations@casagrand.co.in

# Server Port
PORT=3000

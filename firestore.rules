rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return signedIn() && role() == 'admin';
    }
    function isAuditor() {
      return signedIn() && role() == 'auditor';
    }
    function isSpoc() {
      return signedIn() && role() == 'spoc';
    }
    function isHod() {
      return signedIn() && role() == 'hod';
    }
    function isStaff() {
      return signedIn() && (role() in ['admin', 'auditor', 'spoc', 'hod']);
    }

    // ── Users: any signed-in staff can view names; only admins manage accounts ──
    match /users/{userId} {
      allow read: if isStaff();
      allow create, update, delete: if isAdmin();
    }

    // ── Departments: visible to all staff, maintained by admins only ──
    match /departments/{ref} {
      allow read: if isStaff();
      allow create, update, delete: if isAdmin();
    }

    // ── Plans: auditors and admins create/update; only admins delete ──
    match /plans/{planId} {
      allow read: if isStaff();
      allow create, update: if isAdmin() || isAuditor();
      allow delete: if isAdmin();
    }

    // ── Audits: auditors submit; admins manage ──
    match /audits/{auditId} {
      allow read: if isStaff();
      allow create, update: if isAdmin() || isAuditor();
      allow delete: if isAdmin();
    }

    // ── Tasks: SPOCs may respond only on tasks for departments they own ──
    match /tasks/{taskId} {
      allow read: if isStaff();
      allow create: if isAdmin() || isAuditor();
      allow update: if isAdmin() || isAuditor()
        || (isSpoc() && resource.data.dept in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.depts);
      allow delete: if isAdmin();
    }

    // ── Settings: readable app-wide, writable by admins ──
    match /settings/{docId} {
      allow read: if isStaff();
      allow create, update, delete: if isAdmin();
    }

    // ── Mail: SMTP trigger queue — staff may enqueue outbound mail;
    // the Trigger Email extension reads/processes these (service-account bypass) ──
    match /mail/{docId} {
      allow create: if isStaff();
      allow read: if isStaff();
      allow update, delete: if isAdmin();
    }
  }
}